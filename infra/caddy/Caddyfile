# The "web" container: the one door into SlicePizza.
#
#   https://slicepizza.senatore.tech/          -> the menu site (static files)
#   https://slicepizza.senatore.tech/api/...   -> the Orders API (/api is removed)
#
# Site and API share one origin, so the browser needs no CORS (see ADR 0003).
#
# HTTPS: in production the server's own proxy (Dokploy) holds the certificate
# for the domain and forwards plain HTTP to this container. Caddy therefore
# only listens on :8080 and does not try to get certificates itself.
#
# Settings from the environment:
#   API_HOST, API_PORT where the API listens                 (default api, 8000)
#   SITE_ROOT          folder with the site's files          (default /srv)
#   EXTRA_CONNECT_SRC  other origins the page may call, space-separated
#                      (default none: the page only calls its own /api).
#                      Needed only if config.js points at an API elsewhere.
#   TELEGRAM_BOT_USERNAME  the bot for "Follow on Telegram", without the @
#                      (default none: no button). See config.js below.
#   KITCHEN_PASSWORD_HASH  bcrypt hash of the kitchen's password, from
#                      `caddy hash-password`, base64-encoded or not (default
#                      none: /kitchen is off). The image's start script turns
#                      the kitchen off if the value is malformed (start.sh).
#                      Caddy passes it to the API, which checks the login
#                      (ADR 0024).
#   KITCHEN_API_TOKEN  the same value as on the API: proves to it that a
#                      request came through the kitchen's route
#   KITCHEN_USERNAME   no longer used (the login asks only for the password)
#   KITCHEN_ROOT       folder with the kitchen page     (default /srv-kitchen)
{
	# No admin endpoint, no certificates, nothing written to disk:
	# the container can run as an unprivileged user.
	admin off
	auto_https off
	persist_config off

	servers {
		# Requests arrive through the server's proxy (Traefik, in Dokploy) or
		# Docker's port forwarding, both from private addresses. Trusting them
		# keeps the X-Forwarded-For and X-Forwarded-Proto they send, so the
		# access log and the API see the customer's IP and "https", not the
		# proxy's IP and "http". Nothing outside the server reaches :8080.
		# The default also trusts 100.64.0.0/10, the shared address space where
		# the live server's Traefik is (100.80.1.0/24): without it every
		# customer looked like Traefik's address to the order rate limit and
		# the kitchen login's lockout (#98, tested in Docker). Like the private
		# ranges, nothing in it reaches :8080 from outside the server.
		# TRUSTED_PROXIES replaces the default: space-separated, and list
		# "private_ranges 100.64.0.0/10" again to keep them.
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges 100.64.0.0/10}
		client_ip_headers X-Forwarded-For
		# Read X-Forwarded-For from the right, skipping trusted proxies, so a
		# customer who sends their own X-Forwarded-For can't pick their address.
		trusted_proxies_strict
	}
}

# Where the API is (Phase 7, ADR 0020). "dynamic a" asks Docker's DNS for every
# address behind the name, every 5 seconds, so several API containers (replicas)
# share the requests, and one that disappears is dropped without a restart.
# With a single API container it behaves as before.
#   API_HOST   the API's service name   (default api)
#   API_PORT   its port                  (default 8000)
(api_upstream) {
	dynamic a {
		name {$API_HOST:api}
		port {$API_PORT:8000}
		refresh 5s
	}
	lb_policy round_robin
	# The API gets exactly one address: the customer's, as worked out above.
	# (Passing the whole chain would make the API, which trusts only private
	# ranges, take the proxy's address instead.)
	header_up X-Forwarded-For {client_ip}
	# If a copy is gone, try another one instead of failing the request.
	lb_try_duration 3s
	lb_try_interval 250ms
}

# Headers for the pages: the menu site and the kitchen.
(page_headers) {
	header {
		# Every deploy can change the HTML, JavaScript and config.js. The
		# browser keeps them but asks first (cheap: 304 Not Modified).
		Cache-Control "no-cache"
		# Only this site's own files, plus the fonts from Google Fonts.
		# The swagger page at /api/docs is not covered (different handle).
		Content-Security-Policy "default-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' {$EXTRA_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}
}

:8080 {
	encode zstd gzip

	# One access log line per request, on stdout (docker compose logs web).
	log

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# The commit this image was built from (GIT_COMMIT, set by the pipeline,
	# ADR 0008). The deploy reads it to check the new version is the one live.
	handle /version {
		header Cache-Control "no-store"
		header Content-Type "text/plain; charset=utf-8"
		respond "{$GIT_COMMIT:unknown}"
	}

	# The version history (releases.toml, ADR 0010), made when the image was
	# built: the kitchen's "What's new" and the version at the bottom of the
	# pages read it. Public, like the releases on GitHub.
	handle /releases.json {
		root * /srv-data
		file_server
		import page_headers
	}

	# The API's /internal routes are for the notification worker only, on the
	# project network (ADR 0006): never reachable from the internet. The API
	# also requires a token there; this keeps them out of reach either way.
	@internal path /api/internal /api/internal/*
	handle @internal {
		respond "Not Found" 404
	}

	# The kitchen board (ADR 0024). The page itself is public and holds no
	# data; the API checks the login and the session behind /kitchen/api.
	# Off (404) until KITCHEN_PASSWORD_HASH is set.
	@kitchen_off {
		path /kitchen /kitchen/*
		expression `{env.KITCHEN_PASSWORD_HASH} == ""`
	}
	handle @kitchen_off {
		respond "Not Found" 404
	}

	@kitchen path /kitchen /kitchen/*
	handle @kitchen {
		redir /kitchen /kitchen/ 308

		# The page's API calls: /kitchen/api/orders reaches the API as /orders.
		# Two headers only this container can add (they replace anything the
		# browser sends): the kitchen token, which tells the API the request
		# came through here, and the password's hash, which the API checks
		# the login against (POST /kitchen/api/session). The public /api
		# route adds neither, so a session cookie or a login only works here.
		handle_path /kitchen/api/* {
			header X-Robots-Tag "noindex, nofollow"
			reverse_proxy {
				import api_upstream
				header_up X-Kitchen-Proxy {$KITCHEN_API_TOKEN}
				header_up X-Kitchen-Password-Hash {$KITCHEN_PASSWORD_HASH}
			}
		}

		handle_path /kitchen/* {
			root * {$KITCHEN_ROOT:/srv-kitchen}
			file_server
			import page_headers
			header X-Robots-Tag "noindex, nofollow"
		}
	}

	# /api/menu reaches the API as /menu. The API is started with
	# UVICORN_ROOT_PATH=/api, so the links it generates (the interactive docs
	# at /api/docs) include the prefix.
	handle_path /api/* {
		# Search engines should find the menu site, never the API or the kitchen.
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy {
			import api_upstream
			# Only the kitchen's route may carry these (ADR 0024). The API
			# would refuse a forged one anyway (it needs the token), but the
			# public route never forwards them.
			header_up -X-Kitchen-Proxy
			header_up -X-Kitchen-Password-Hash
		}
	}

	# The fonts (task 9.6): ours, not Google's. They never change under the same
	# name, so browsers may keep them for 30 days.
	handle /fonts/* {
		root * {$SITE_ROOT:/srv}
		file_server
		header Cache-Control "public, max-age=2592000"
	}

	handle {
		root * {$SITE_ROOT:/srv}

		# config.js is a template: Caddy fills in settings from the container's
		# environment when it serves it, so one image works everywhere. Only
		# that file: the others are served as they are.
		#   TELEGRAM_BOT_USERNAME  the bot behind "Follow on Telegram" (ADR 0006);
		#                          empty: no button
		@config path /config.js
		templates @config {
			mime application/javascript text/javascript
		}
		file_server

		import page_headers
	}
}
