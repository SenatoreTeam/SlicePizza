// Grafana Alloy for SlicePizza (ADR 0014): reads every container's logs and
// sends them to Loki. It talks to Docker through the read-only socket proxy
// (docker-compose.yml), never to the Docker socket itself.
discovery.docker "containers" {
  host = "tcp://socket-proxy:2375"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // service = the compose service name (api, worker, caddy...); container = its name.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "tcp://socket-proxy:2375"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
